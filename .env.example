# Lab 14 — AI Evaluation Benchmarking
# Copy file này thành .env và điền API key của bạn

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model dùng cho Judge (mặc định gpt-4o-mini để tiết kiệm cost)
JUDGE_MODEL=gpt-4o-mini

# Model dùng cho Agent
AGENT_MODEL=gpt-4o-mini

# Đường dẫn ChromaDB từ lab 08 (dùng lại)
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=rag_lab
